{
  "name": "neiist",
  "version": "1.16.1",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "scripts": {
    "setup": "chmod +x ./scripts/setup.sh && ./scripts/setup.sh",
    "setup:notion": "node scripts/setup-notion.mts",
    "setup:service-accounts": "node scripts/setup-google.mts",
    "dev": "docker compose -f ./docker/docker-compose.yml up -d && next dev --turbopack; docker compose -f ./docker/docker-compose.yml stop > /dev/null 2>&1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint -c ./config/eslint/eslint.config.mjs .",
    "lint:fix": "eslint -c ./config/eslint/eslint.config.mjs --fix .",
    "lint:staged": "lint-staged -c ./config/eslint/lintstagedrc.mjs",
    "format": "prettier --config ./config/prettier/.prettierrc.json --ignore-path ./config/prettier/.prettierignore --write .",
    "format:check": "prettier --config ./config/prettier/.prettierrc.json --ignore-path ./config/prettier/.prettierignore --check .",
    "type:check": "tsc --noEmit",
    "db:reset": "docker compose -f ./docker/docker-compose.yml down && docker volume rm neiist_db && docker compose -f ./docker/docker-compose.yml up -d",
    "db:seed": "node scripts/seed-db.mts",
    "manage-calendars": "node scripts/manage-calendars.mts",
    "clean": "rm -rf .next out dist build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@notionhq/client": "^5.23.3",
    "@sumup/sdk": "^0.1.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react-big-calendar": "^1.16.3",
    "baseline-browser-mapping": "^2.11.10",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "googleapis": "^171.4.0",
    "hamburger-react": "^2.5.2",
    "ical-generator": "^10.2.0",
    "jsonwebtoken": "^9.0.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "p-limit": "^7.3.1",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-big-calendar": "1.19.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "swiper": "^12.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "16.2.12",
    "@types/node": "^25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@clack/prompts": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-validate-filename": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "node-cron": "^4.6.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
