FENIX_CLIENT_ID=
FENIX_CLIENT_SECRET=
FENIX_REDIRECT_URI=http://localhost:3000/api/auth/callback
# This username and password must match the ones created in schema.sql
DATABASE_URL=postgresql://neiist_app_user:CHANGE_ME_TO_A_SECURE_PASSWORD@localhost:5432/neiist
# Gmail configarition to send emails
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
# Application public url
NEXT_PUBLIC_BASE_URL=https://localhost:3000
# Notion Calendar API
NOTION_API_KEY=your_notion_secret
DATABASE_ID=your_database_id
VERIFICATION_TOKEN=verification_token
# Google Calendar Service Account
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# Google Drive Service Account
GDRIVE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GDRIVE_CV_FOLDER_ID=folder_id
GDRIVE_SWEATS_FOLDER_ID=folder_id
GDRIVE_BACKUP_FOLDER_ID=folder_id
#SumUp API Key
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_PAY_TO_EMAIL=
JWT_SECRET=your-very-secret-key
MBWAY_NUMBERS=comma-separated
NEXT_PUBLIC_JANTAR_DE_CURSO_ACTIVITY_ID=

DEV_ISTID=ist119999[ADMIN]

# ── OpenTelemetry ──
# gRPC endpoint where Grafana Alloy listens for OTLP data.
# Default: http://127.0.0.1:4317 (local Alloy instance)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# HMAC key used to pseudonymize user IDs (istid) in logs and traces.
# If not set, falls back to JWT_SECRET. Generate a dedicated key for production:
#   openssl rand -hex 32
OTEL_PSEUDONYMIZE_KEY=

# Log level for Pino logger (trace, debug, info, warn, error, fatal).
# Defaults to "debug" in development, "info" in production.
LOG_LEVEL=